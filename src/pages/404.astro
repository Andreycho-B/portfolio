---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Página no encontrada | Andrey Rondón"
  description="La página que buscas no existe o ha sido trasladada."
  noindex={true}
>
  <main class="not-found-stage">
    <div class="not-found-content">
      <span class="not-found-badge">Error 404</span>
      <h1 class="not-found-title">Página no encontrada</h1>
      <p class="not-found-desc">
        La ruta solicitada no existe o ha cambiado de ubicación dentro del portafolio.
      </p>
      <div class="not-found-actions">
        <a href="/" class="not-found-btn" data-not-found-home data-cursor-expand="Inicio">
          <span>Volver al inicio</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M1 7h12M8 2l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-stage {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(2rem + env(safe-area-inset-top)) calc(2rem + env(safe-area-inset-right))
      calc(2rem + env(safe-area-inset-bottom)) calc(2rem + env(safe-area-inset-left));
    background: var(--color-bg);
    color: var(--color-fg);
    text-align: center;
  }

  .not-found-content {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .not-found-badge {
    display: inline-block;
    font-family: var(--font-text);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
  }

  .not-found-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
  }

  .not-found-desc {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .not-found-actions {
    margin-top: 1rem;
  }

  .not-found-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.85rem 1.6rem;
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: 9999px;
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
  }

  .not-found-btn:hover {
    transform: scale(1.03);
    opacity: 0.9;
  }

  .not-found-btn:active {
    transform: scale(0.98);
  }
</style>

<script>
  import { getCursorController } from "../design-system/components/cursor-controller";
  import { bindCursorExpandTriggers } from "../design-system/components/cursor-events";
  import {
    initIncomingFluidWipe,
    isModifiedClick,
    navigateWithFluidWipe,
  } from "../features/transitions/fluid-transition-controller";

  const initNotFoundPage = () => {
    initIncomingFluidWipe();
    const cursor = getCursorController();
    cursor.enable();
    const cleanupExpand = bindCursorExpandTriggers(document.body, cursor);
    const homeLink = document.querySelector<HTMLAnchorElement>("[data-not-found-home]");
    const handleClick = (e: MouseEvent) => {
      if (isModifiedClick(e)) return;
      e.preventDefault();
      navigateWithFluidWipe({ targetUrl: "/" });
    };
    homeLink?.addEventListener("click", handleClick);
    document.addEventListener(
      "astro:before-swap",
      () => {
        cleanupExpand();
        homeLink?.removeEventListener("click", handleClick);
      },
      { once: true },
    );
  };

  document.addEventListener("astro:page-load", initNotFoundPage);
</script>
