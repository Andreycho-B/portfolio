---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutHeader from "../features/about/AboutHeader.astro";
import AboutShowcase from "../features/about/AboutShowcase.astro";
import AboutFooter from "../features/about/AboutFooter.astro";
import { buildAboutSchemaNodes, buildCanonicalUrl } from "../core/structured-data";
import "../features/about/about.css";
import "../features/about/about-responsive.css";

const aboutCanonical = buildCanonicalUrl("/sobre-mi", Astro.site);
const aboutSchema = buildAboutSchemaNodes(aboutCanonical, "es-CO");
---

<BaseLayout
  title="Sobre Mí — Andrey Rondón | Desarrollador Web en Duitama"
  description="Andrey Rondón, desarrollador web full-stack y frontend creativo en Duitama, Boyacá, Colombia. ADSO (SENA): TypeScript, Go, Astro, Three.js, PWA y PostgreSQL."
  extraSchema={aboutSchema}
>
  <div class="about-page-stage">
    <AboutHeader />
    <main class="about-main-content">
      <AboutShowcase />
      <AboutFooter />
    </main>
  </div>
</BaseLayout>

<script>
  import { initAboutPage } from "../features/about/about-controller";

  document.addEventListener("astro:page-load", initAboutPage);
</script>
