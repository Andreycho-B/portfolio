---
import MorphicText from "../design-system/components/MorphicText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Test mórfico — Andrey" description="Verificación del efecto mórfico.">
  <main>
    <MorphicText text="Bienvenido" as="h1" exitDelay={1.8} loop={true} />
  </main>
</BaseLayout>

<style>
  main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--container-padding);
  }

  main :global(.morphic-text) {
    font-size: var(--text-4xl);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tighter);
  }
</style>
