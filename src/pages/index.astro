---
import MorphicText from "../design-system/components/MorphicText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Andrey — Desarrollador Creativo" description="Portafolio personal de Andrey.">
  <main>
    <MorphicText
      phrases={["Bienvenido", "Soy Andrey", "Desarrollador Creativo"]}
      as="h1"
      duration={1.6}
      exitDelay={0.8}
    />
  </main>
</BaseLayout>

<style>
  main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--container-padding);
    text-align: center;
  }

  main :global(.morphic-text) {
    font-size: var(--text-4xl);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tighter);
  }
</style>
