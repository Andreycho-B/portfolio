---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsentScreen from "../features/consent/ConsentScreen.astro";
import ProjectsScreen from "../features/projects/ProjectsScreen.astro";

// Escena inicial: bienvenida y consentimiento interactivo de audio (Spec §6 y §8)
// Segunda escena: vista de proyectos en espiral (Spec §9.3)
---

<BaseLayout
  title="Andrey — Desarrollador Creativo"
  description="Portafolio personal de Andrey, desarrollador creativo."
>
  <main class="page-root">
    <ConsentScreen />
    <ProjectsScreen />
  </main>
</BaseLayout>

<style>
  .page-root {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow-x: clip;
  }
</style>
