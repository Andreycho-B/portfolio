---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsentScreen from "../features/consent/ConsentScreen.astro";
import ProjectsLensDrum from "../features/projects/ProjectsLensDrum.astro";
import { PROFILE } from "../core/profile";
---

<BaseLayout
  title="Andrey Rondón — Desarrollador de Software Fullstack"
  description={PROFILE.bioLong}
>
  <main class="page-root">
    <ConsentScreen />
    <ProjectsLensDrum />
  </main>
</BaseLayout>

<style>
  .page-root {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
  }
  .page-root > :global(.consent-container) {
    position: absolute;
    inset: 0;
    z-index: 20;
  }
  .page-root > :global(.projects-lens-section) {
    position: absolute;
    inset: 0;
    z-index: 10;
  }
</style>
