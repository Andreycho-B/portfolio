---
import type { ProjectItem } from "../projects/project-data";
import { getProjectLogos } from "./tech-icons";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const logos = getProjectLogos(project.tags ?? [], 28);
const SHAPES = ["circle", "squircle", "pill", "leaf"] as const;
const uniqueTags = project.tags ?? [];
---

<section class="tech-gravity-section" aria-label="Tecnologías del proyecto">
  <div class="sr-only">
    <h3>Tecnologías aplicadas</h3>
    <ul>
      {uniqueTags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>

  <div class="tech-gravity-stage" id="tech-gravity-stage" aria-hidden="true">
    {logos.map((logo, index) => {
      const shape = SHAPES[index % SHAPES.length];
      return (
        <div
          class={`tech-logo-token shape-${shape}`}
          data-tech-logo
          data-shape={shape}
          data-logo-id={logo.id}
          style={`--logo-color: ${logo.color};`}
        >
          <img src={logo.svgUrl} alt="" class="tech-logo-img" loading="lazy" decoding="async" />
        </div>
      );
    })}
  </div>
</section>
