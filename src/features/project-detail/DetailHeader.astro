---
import type { ProjectItem } from "../projects/project-data";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<header class="detail-header">
  <div class="header-left">
    <a
      href="/"
      class="back-trigger"
      aria-label="Volver a los proyectos"
      data-cursor-expand="Volver"
    >
      <svg class="back-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M10 12.5L5.5 8L10 3.5"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="roll-track" data-roll-text>
        proyectos
      </span>
    </a>
  </div>

  <div class="header-right">
    {project.liveUrl && (
      <a
        href={project.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="action-pill"
        aria-label="Visitar sitio en producción"
        data-cursor-expand="Visitar"
      >
        <span class="roll-track" data-roll-text>
          visitar
        </span>
        <span class="pill-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    )}
    {project.repoUrl && (
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="action-pill"
        aria-label="Ver código fuente en GitHub"
        data-cursor-expand="GitHub"
      >
        <span class="roll-track" data-roll-text>
          código
        </span>
        <span class="pill-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    )}
    <button
      type="button"
      class="sound-toggle-btn"
      data-sound-toggle
      aria-label="Silenciar sonido"
      aria-pressed="false"
    >
      <span class="sound-label">SONIDO</span>
      <span class="sound-state" data-sound-state aria-hidden="true">
        [ON]
      </span>
    </button>
  </div>
</header>
