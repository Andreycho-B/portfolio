---
import type { ProjectItem } from "../projects/project-data";

interface Props {
  project: ProjectItem;
  mediaItem1: string;
  mediaDuoLeft: string;
  mediaDuoRight: string;
  mediaItemFinal: string;
}

const { project, mediaItem1, mediaDuoLeft, mediaDuoRight, mediaItemFinal } = Astro.props;
---

<section class="media-artboard-section" data-reveal="fade">
  <div class="device-specimen-wrap">
    <div class="device-frame" data-reveal="scale" data-tilt-card>
      <div class="device-tilt-inner">
        <img
          src={mediaItem1}
          alt={`${project.title} — Captura principal`}
          width="1179"
          height="2556"
          loading="lazy"
          decoding="async"
          class="device-screen-img"
        />
      </div>
    </div>
  </div>
</section>

<section class="media-artboard-section duo-section" data-reveal="fade">
  <div class="duo-specimens-container">
    <div class="device-specimen-wrap">
      <div class="device-frame" data-reveal="scale" data-tilt-card>
        <div class="device-tilt-inner">
          <img
            src={mediaDuoLeft}
            alt={`${project.title} — Flujo de interacción`}
            width="1179"
            height="2556"
            loading="lazy"
            decoding="async"
            class="device-screen-img"
          />
        </div>
      </div>
    </div>
    <div class="device-specimen-wrap">
      <div class="device-frame" data-reveal="scale" data-tilt-card>
        <div class="device-tilt-inner">
          <img
            src={mediaDuoRight}
            alt={`${project.title} — Detalle de pantalla`}
            width="1179"
            height="2556"
            loading="lazy"
            decoding="async"
            class="device-screen-img"
          />
        </div>
      </div>
    </div>
  </div>
</section>

{mediaItemFinal && (
  <section class="media-artboard-section" data-reveal="fade">
    <div class="device-specimen-wrap">
      <div class="device-frame" data-reveal="scale" data-tilt-card>
        <div class="device-tilt-inner">
          <img
            src={mediaItemFinal}
            alt={`${project.title} — Captura de cierre`}
            width="1846"
            height="2304"
            loading="lazy"
            decoding="async"
            class="device-screen-img"
          />
        </div>
      </div>
    </div>
  </section>
)}
