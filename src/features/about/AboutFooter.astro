---
import { PROFILE } from "../../core/profile";
---

<footer class="about-footer-section" aria-label="Contacto">
  <div class="footer-contact-bar" data-reveal="fade">
    <div class="contact-links-row">
      <a href={`mailto:${PROFILE.email}`} class="footer-inline-link" data-cursor-expand="Correo">
        {PROFILE.email}
      </a>
      <span class="footer-dot-sep" aria-hidden="true">
        ·
      </span>
      <a
        href={PROFILE.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-inline-link"
        data-cursor-expand="WhatsApp"
      >
        {PROFILE.phone}
      </a>
      <span class="footer-dot-sep" aria-hidden="true">
        ·
      </span>
      <a
        href={PROFILE.socials.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-inline-link"
        data-cursor-expand="GitHub"
      >
        GitHub
      </a>
      <span class="footer-dot-sep" aria-hidden="true">
        ·
      </span>
      <a
        href={PROFILE.socials.linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-inline-link"
        data-cursor-expand="LinkedIn"
      >
        LinkedIn
      </a>
      <span class="footer-dot-sep" aria-hidden="true">
        ·
      </span>
      <a
        href={PROFILE.socials.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-inline-link"
        data-cursor-expand="Instagram"
      >
        Instagram
      </a>
    </div>

    <div class="footer-nav-back-row">
      <a href="/" class="footer-back-link" data-back-trigger data-cursor-expand="Volver">
        <span class="link-arrow" aria-hidden="true">
          ←
        </span>
        <span>Volver al tambor de proyectos</span>
      </a>
    </div>
  </div>

  <div class="footer-particle-banner">
    <canvas id="footer-particle-canvas" class="footer-particle-canvas" aria-hidden="true"></canvas>
    <span class="sr-only">ANDREY</span>
  </div>
</footer>

<script>
  import { initParticleText } from "./particle-text";

  let particleCleanup: (() => void) | null = null;

  const setupParticles = () => {
    if (particleCleanup) {
      particleCleanup();
      particleCleanup = null;
    }
    const canvas = document.getElementById("footer-particle-canvas");
    if (canvas instanceof HTMLCanvasElement) {
      particleCleanup = initParticleText(canvas);
    }
  };

  document.addEventListener("astro:page-load", setupParticles);
  document.addEventListener("astro:before-swap", () => {
    if (particleCleanup) {
      particleCleanup();
      particleCleanup = null;
    }
  });
</script>
