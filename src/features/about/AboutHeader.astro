---
---

<header class="about-header">
  <div class="header-left">
    <a
      href="/"
      class="back-nav-arrow"
      data-back-trigger
      aria-label="Volver a proyectos"
      data-cursor-expand="Volver"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </a>
  </div>

  <div class="header-right">
    <button
      type="button"
      class="sound-toggle-btn"
      data-sound-toggle
      aria-label="Silenciar sonido"
      aria-pressed="false"
      data-cursor-expand="Sonido"
    >
      <span class="sound-label">SONIDO</span>
      <span class="sound-state" data-sound-state aria-hidden="true">
        [ON]
      </span>
    </button>
  </div>
</header>
