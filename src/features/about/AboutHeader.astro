---
---

<header class="about-header">
  <div class="header-left">
    <a
      href="/"
      class="back-nav-arrow"
      data-back-trigger
      aria-label="Volver a proyectos"
      data-cursor-expand="Volver"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 3.5L5.5 8L10 12.5"></path>
      </svg>
    </a>
  </div>

  <div class="header-right">
    <button
      type="button"
      class="sound-toggle-btn"
      data-sound-toggle
      aria-label="Silenciar sonido"
      aria-pressed="false"
    >
      <span class="sound-label">SONIDO</span>
      <span class="sound-state" data-sound-state aria-hidden="true">
        [ON]
      </span>
    </button>
  </div>
</header>
