<section class="projects-root" data-projects-screen hidden>
  <div class="projects-stage">
    <canvas
      class="helix-canvas"
      data-helix-canvas
      role="img"
      aria-label="Espiral de proyectos"
    ></canvas>
  </div>
</section>

<style>
  .projects-root {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-bg);
    touch-action: none;
  }
  .projects-stage {
    height: 100%;
  }
  .helix-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .helix-canvas.is-revealed {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .helix-canvas {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  import { HELIX_CARD_DATA } from "./helix-cards-data";
  import type { HelixSceneHandle } from "./helix-cards.types";

  const mountProjectsZone = (): void => {
    const zone = document.querySelector<HTMLElement>("[data-projects-screen]");
    const canvas = zone?.querySelector<HTMLCanvasElement>("[data-helix-canvas]");
    if (!zone || !canvas || zone.dataset.zoneMounted === "true") return;
    zone.dataset.zoneMounted = "true";

    let helix: HelixSceneHandle | null = null;

    const WHEEL_LINE_PX = 16;
    const PX_PER_SLOT = 140;
    const TOUCH_GAIN = 1.4;
    const HELIX_LAP_SLOTS = 12;
    const MOMENTUM_WINDOW_MS = 80;
    const MOMENTUM_CARRY_MS = 240;
    const MOMENTUM_MAX_PX = 3 * PX_PER_SLOT;

    const revealProjectsZone = () => {
      zone.hidden = false;
      void import("./helix-scene")
        .then(({ createHelixScene }) => createHelixScene(canvas, HELIX_CARD_DATA))
        .then((scene) => {
          if (!scene) return;
          helix = scene;
          const width = zone.clientWidth;
          const height = zone.clientHeight;
          scene.resize(width, height);
          scene.start();
          canvas.classList.add("is-revealed");
        });
    };

    document.addEventListener("consent:completed", revealProjectsZone, { once: true });

    const preloadHelixScene = () => {
      void import("./helix-scene");
    };
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(preloadHelixScene, { timeout: 2000 });
    } else {
      window.setTimeout(preloadHelixScene, 1500);
    }

    // Scroll nativo y zoom desactivados: los gestos alimentan el flujo helicoidal
    const onZoneWheel = (event: WheelEvent) => {
      if (zone.hidden) return;
      event.preventDefault();
      const deltaPx =
        event.deltaMode === 1
          ? event.deltaY * WHEEL_LINE_PX
          : event.deltaMode === 2
            ? event.deltaY * zone.clientHeight
            : event.deltaY;
      helix?.scrollBy(deltaPx);
    };
    window.addEventListener("wheel", onZoneWheel, { passive: false });

    const onZoneKeyDown = (event: KeyboardEvent) => {
      if (zone.hidden || !helix) return;
      const slots =
        event.key === "ArrowDown"
          ? 1
          : event.key === "ArrowUp"
            ? -1
            : event.key === "PageDown"
              ? 3
              : event.key === "PageUp"
                ? -3
                : null;
      if (slots !== null) {
        event.preventDefault();
        helix.scrollBy(slots * PX_PER_SLOT);
        return;
      }
      if (event.key === "Home") {
        event.preventDefault();
        helix.scrollTo(0);
      } else if (event.key === "End") {
        event.preventDefault();
        helix.scrollTo(HELIX_LAP_SLOTS);
      }
    };
    window.addEventListener("keydown", onZoneKeyDown);

    let trackedTouchId: number | null = null;
    let lastTouchY: number | null = null;
    let touchSamples: { time: number; deltaPx: number }[] = [];
    const resetTouchDrag = () => {
      trackedTouchId = null;
      lastTouchY = null;
      touchSamples = [];
    };
    const onZoneTouchStart = (event: TouchEvent) => {
      if (event.touches.length !== 1) {
        resetTouchDrag();
        return;
      }
      const touch = event.touches.item(0);
      if (touch) {
        trackedTouchId = touch.identifier;
        lastTouchY = touch.clientY;
        touchSamples = [];
      }
    };
    const onZoneTouchMove = (event: TouchEvent) => {
      if (zone.hidden) return;
      event.preventDefault();
      if (event.touches.length !== 1) {
        resetTouchDrag();
        return;
      }
      const touch = event.touches.item(0);
      if (!touch) return;
      if (touch.identifier !== trackedTouchId || lastTouchY === null) {
        trackedTouchId = touch.identifier;
        lastTouchY = touch.clientY;
        touchSamples = [];
        return;
      }
      const deltaPx = (lastTouchY - touch.clientY) * TOUCH_GAIN;
      helix?.scrollBy(deltaPx);
      lastTouchY = touch.clientY;
      const now = performance.now();
      touchSamples.push({ time: now, deltaPx });
      touchSamples = touchSamples.filter((sample) => now - sample.time <= MOMENTUM_WINDOW_MS);
    };
    const onZoneTouchEnd = () => {
      const first = touchSamples[0];
      const last = touchSamples[touchSamples.length - 1];
      if (first && last) {
        const elapsed = last.time - first.time;
        if (elapsed > 0) {
          const totalPx = touchSamples.reduce((sum, sample) => sum + sample.deltaPx, 0);
          const momentumPx = (totalPx / elapsed) * MOMENTUM_CARRY_MS;
          helix?.scrollBy(Math.min(MOMENTUM_MAX_PX, Math.max(-MOMENTUM_MAX_PX, momentumPx)));
        }
      }
      resetTouchDrag();
    };
    zone.addEventListener("touchstart", onZoneTouchStart, { passive: false });
    zone.addEventListener("touchmove", onZoneTouchMove, { passive: false });
    zone.addEventListener("touchend", onZoneTouchEnd);
    zone.addEventListener("touchcancel", onZoneTouchEnd);

    const onZoneResize = () => {
      if (helix && !zone.hidden) helix.resize(zone.clientWidth, zone.clientHeight);
    };
    window.addEventListener("resize", onZoneResize);

    const destroy = () => {
      window.removeEventListener("wheel", onZoneWheel);
      window.removeEventListener("keydown", onZoneKeyDown);
      zone.removeEventListener("touchstart", onZoneTouchStart);
      zone.removeEventListener("touchmove", onZoneTouchMove);
      zone.removeEventListener("touchend", onZoneTouchEnd);
      zone.removeEventListener("touchcancel", onZoneTouchEnd);
      window.removeEventListener("resize", onZoneResize);
      document.removeEventListener("consent:completed", revealProjectsZone);
      helix?.dispose();
    };
    document.addEventListener("astro:before-swap", destroy, { once: true });
  };

  if (document.readyState !== "loading") mountProjectsZone();
  else document.addEventListener("DOMContentLoaded", mountProjectsZone);
  document.addEventListener("astro:page-load", mountProjectsZone);
</script>
