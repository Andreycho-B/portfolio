<section class="projects-root" data-projects-screen hidden>
  <div class="projects-stage">
    <canvas
      class="helix-canvas"
      data-helix-canvas
      role="img"
      aria-label="Espiral de proyectos"
    ></canvas>
  </div>
  <div class="projects-fallback" data-projects-fallback hidden>
    <p class="fallback-label">Proyectos</p>
    <ol class="fallback-list"></ol>
  </div>
</section>

<style>
  .projects-root {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-bg);
    touch-action: none;
  }
  .projects-stage {
    height: 100%;
  }
  .helix-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .helix-canvas.is-revealed {
    opacity: 1;
  }
  .projects-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
    padding: calc(var(--container-padding) + env(safe-area-inset-top)) var(--container-padding)
      calc(var(--container-padding) + env(safe-area-inset-bottom));
    background: var(--color-bg);
  }
  .fallback-label {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    letter-spacing: var(--ls-labels);
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .fallback-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .fallback-list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-sm);
  }
  .fallback-index {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
  }
  .fallback-name {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--text-xl);
    color: var(--color-fg);
  }
  .fallback-discipline {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .helix-canvas {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  import { HELIX_CARD_DATA } from "./helix-cards-data";
  import type { HelixSceneHandle } from "./helix-cards.types";
  import { mountHelixInput } from "./helix-input";

  const mountProjectsZone = (): void => {
    const zone = document.querySelector<HTMLElement>("[data-projects-screen]");
    const canvas = zone?.querySelector<HTMLCanvasElement>("[data-helix-canvas]");
    if (!zone || !canvas || zone.dataset.zoneMounted === "true") return;
    zone.dataset.zoneMounted = "true";

    let helix: HelixSceneHandle | null = null;

    const fallback = zone.querySelector<HTMLElement>("[data-projects-fallback]");
    const fallbackList = zone.querySelector<HTMLOListElement>(".fallback-list");

    const showProjectsFallback = () => {
      if (!fallback || !fallbackList || fallback.dataset.filled === "true") return;
      fallback.dataset.filled = "true";
      for (const project of HELIX_CARD_DATA) {
        const item = document.createElement("li");
        const index = document.createElement("span");
        index.className = "fallback-index";
        index.textContent = project.index;
        const name = document.createElement("span");
        name.className = "fallback-name";
        name.textContent = project.name;
        const discipline = document.createElement("span");
        discipline.className = "fallback-discipline";
        discipline.textContent = project.discipline;
        item.append(index, name, discipline);
        fallbackList.append(item);
      }
      fallback.hidden = false;
    };

    const revealProjectsZone = () => {
      zone.hidden = false;
      void import("./helix-scene")
        .then(({ createHelixScene }) =>
          createHelixScene(canvas, HELIX_CARD_DATA, showProjectsFallback),
        )
        .then((scene) => {
          if (!scene) {
            showProjectsFallback();
            return;
          }
          helix = scene;
          const width = zone.clientWidth;
          const height = zone.clientHeight;
          scene.resize(width, height);
          scene.start();
          canvas.classList.add("is-revealed");
        })
        .catch(() => {
          showProjectsFallback();
        });
    };

    document.addEventListener("consent:completed", revealProjectsZone, { once: true });

    const preloadHelixScene = () => {
      void import("./helix-scene");
    };
    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(preloadHelixScene, { timeout: 2000 });
    } else {
      window.setTimeout(preloadHelixScene, 1500);
    }

    const input = mountHelixInput(zone, {
      isZoneVisible: () => !zone.hidden,
      zoneClientHeight: () => zone.clientHeight,
      advanceBy: (deltaPx) => helix?.scrollBy(deltaPx),
      advanceTo: (slots) => helix?.scrollTo(slots),
    });

    const onZoneResize = () => {
      if (helix && !zone.hidden) helix.resize(zone.clientWidth, zone.clientHeight);
    };
    window.addEventListener("resize", onZoneResize);

    const destroy = () => {
      input.dispose();
      window.removeEventListener("resize", onZoneResize);
      document.removeEventListener("consent:completed", revealProjectsZone);
      helix?.dispose();
    };
    document.addEventListener("astro:before-swap", destroy, { once: true });
  };

  if (document.readyState !== "loading") mountProjectsZone();
  else document.addEventListener("DOMContentLoaded", mountProjectsZone);
  document.addEventListener("astro:page-load", mountProjectsZone);
</script>
