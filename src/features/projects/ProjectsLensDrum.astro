---
import { PROJECTS } from "./project-data";
import StudioPreloader from "./StudioPreloader.astro";
import "./projects-drum.css";
---

<StudioPreloader />

<section
  class="projects-lens-section"
  data-projects-section
  data-stage-mode="studio"
  hidden
  aria-label="Proyectos seleccionados"
>
  <button
    type="button"
    class="studio-sound-btn"
    data-studio-sound-toggle
    aria-label="Silenciar modo ambiente"
    aria-pressed="false"
    data-nosnippet
  >
    <svg
      class="studio-sound-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M11 6.5L6.8 9.8H4.2a.7.7 0 0 0-.7.7v3a.7.7 0 0 0 .7.7h2.6L11 17.5V6.5Z"></path>
      <g class="studio-sound-waves">
        <path class="wave-inner" d="M14.4 9.3a3.8 3.8 0 0 1 0 5.4"></path>
        <path class="wave-outer" d="M17.1 6.8a7.2 7.2 0 0 1 0 10.4"></path>
      </g>
      <g class="studio-sound-mute">
        <path d="M15.2 9.7l4.6 4.6"></path>
        <path d="M19.8 9.7l-4.6 4.6"></path>
      </g>
    </svg>
  </button>

  <p class="studio-entry-hint" data-studio-entry-hint data-nosnippet>
    Siéntate para comenzar · o explora libremente
  </p>

  <p class="studio-scroll-hint" data-studio-scroll-hint data-nosnippet aria-hidden="true">
    <span class="studio-scroll-label-desktop">Desliza · rueda o touchpad</span>
    <span class="studio-scroll-label-touch">Desliza para explorar</span>
  </p>

  <div
    class="drum-viewport"
    data-drum-viewport
    tabindex="0"
    role="region"
    aria-label="Carrete interactivo de proyectos. Usa las flechas arriba y abajo, Inicio o Fin para rotar, y Enter o Espacio para abrir"
  >
    <canvas class="drum-webgl-canvas" data-drum-canvas aria-hidden="true"></canvas>
    <div class="drum-fallback-cards" data-drum-fallback aria-hidden="true">
      {PROJECTS.map((project) => (
        <a
          href={project.externalUrl ?? `/proyectos/${project.slug}`}
          class="fallback-card"
          tabindex="-1"
        >
          <img
            src={project.imageSrc}
            alt={`Captura del proyecto ${project.title}`}
            class="fallback-card-img"
            width={project.coverWidth}
            height={project.coverHeight}
            loading="lazy"
            decoding="async"
          />
          <span class="fallback-card-title">{project.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { mountProjectsScreen } from "./projects-screen-mount";

  document.addEventListener("astro:page-load", mountProjectsScreen);
</script>
