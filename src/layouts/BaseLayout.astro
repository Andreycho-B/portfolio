---
import { ClientRouter } from "astro:transitions";
import { PROFILE } from "../core/profile";
import InteractiveCursor from "../design-system/components/InteractiveCursor.astro";
import "../design-system/tokens/index.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
  type?: string;
}

const {
  title = `${PROFILE.shortName} — ${PROFILE.role}`,
  description = PROFILE.bioLong,
  lang = "es",
  image = "/og-image.jpg",
  type = "website",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const socialImageURL = Astro.site ? new URL(image, Astro.site).href : image;

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: PROFILE.fullName,
  alternateName: PROFILE.alternateNames,
  jobTitle: PROFILE.role,
  description: PROFILE.bioShort,
  url: PROFILE.siteUrl,
  sameAs: [PROFILE.socials.github.url, PROFILE.socials.linkedin.url, PROFILE.socials.instagram.url],
  alumniOf: {
    "@type": "EducationalOrganization",
    name: PROFILE.education.institution,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: PROFILE.location.city,
    addressRegion: PROFILE.location.region,
    addressCountry: PROFILE.location.country,
  },
  knowsAbout: PROFILE.skills,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE.fullName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph & WhatsApp Social Previews -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Andrey Rondón`} />
    <meta property="og:site_name" content="Andrey Rondón — Portfolio" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={`${title} — Andrey Rondón`} />

    <!-- Mobile Edge-to-Edge & PWA Metadata -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Andrey" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#000000" />

    <script type="application/ld+json" set:html={personSchema} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="preload"
      href="/fonts/author/Author-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/karrik/Karrik-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
      }
    </style>
    <title>{title}</title>
  </head>
  <body>
    <InteractiveCursor />
    <div
      id="fluid-transition-overlay"
      aria-hidden="true"
      transition:persist="fluid-transition-overlay"
      style="position: fixed; inset: 0; z-index: 999999; pointer-events: none; overflow: hidden; will-change: transform;"
    >
      <svg
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        style="width: 100%; height: 100%; display: block;"
      >
        <path
          class="fluid-layer-lead"
          d="M 0 100 L 100 100 L 100 100 L 0 100 Z"
          fill="#1a1714"
          vector-effect="non-scaling-stroke"
        ></path>
        <path
          class="fluid-layer-body"
          d="M 0 100 L 100 100 L 100 100 L 0 100 Z"
          fill="var(--color-bg, #ffffff)"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
    </div>
    <slot />
  </body>
</html>
