---
interface Props {
  defaultLabel?: string;
}

const { defaultLabel = "Entrar" } = Astro.props;
---

<div class="interactive-cursor" data-interactive-cursor aria-hidden="true">
  <div class="cursor-pill" data-cursor-pill>
    <div class="cursor-content" data-cursor-content>
      <span class="cursor-text" data-cursor-text>
        {defaultLabel}
      </span>
      <svg class="cursor-icon" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path
          d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
    <svg class="cursor-mute-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M2.5 6.5H5.5L9 3.5V12.5L5.5 9.5H2.5V6.5Z"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M11.5 6.5L14.5 9.5M14.5 6.5L11.5 9.5"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</div>

<style>
  .interactive-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    z-index: var(--z-cursor);
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
    transition: opacity var(--dur-fast) var(--ease-fast);
  }

  .interactive-cursor.is-visible {
    opacity: 1;
  }

  .cursor-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-pill);
    background-color: #ffffff;
    color: #1a1714;
    border: 1px solid rgba(26, 23, 20, 0.12);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
    overflow: hidden;
    transform-origin: center center;
    will-change: width, height, transform;
    contain: layout paint;
    transition:
      width 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .interactive-cursor.is-expanded .cursor-pill {
    width: 86px;
    height: 32px;
    padding: 0 var(--space-xs);
  }

  .cursor-content {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    opacity: 0;
    transform: scale(0.65);
    transition:
      opacity 0.12s ease-out,
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .interactive-cursor.is-expanded .cursor-content {
    opacity: 1;
    transform: scale(1);
    transition-delay: 30ms;
  }

  .cursor-text {
    font-family: var(--font-text);
    font-size: var(--text-xs);
    letter-spacing: var(--ls-labels);
    text-transform: uppercase;
    font-weight: var(--weight-regular);
    line-height: 1;
  }

  .cursor-icon {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .cursor-mute-icon {
    position: absolute;
    width: 14px;
    height: 14px;
    color: #1a1714;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.12s ease-out,
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .interactive-cursor.is-pressed .cursor-pill {
    transform: scale(0.9);
  }

  .interactive-cursor.is-muted .cursor-pill {
    width: 38px;
    height: 38px;
    background-color: #ffffff;
    border-color: rgba(26, 23, 20, 0.16);
    color: #1a1714;
    opacity: 1;
  }

  .interactive-cursor.is-muted .cursor-content {
    opacity: 0;
  }

  .interactive-cursor.is-muted .cursor-mute-icon {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: none) or (pointer: coarse) {
    .interactive-cursor {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-pill,
    .cursor-content {
      transition: none !important;
    }
  }
</style>
