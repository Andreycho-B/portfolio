---
interface Props {
  defaultLabel?: string;
}

const { defaultLabel = "Ingresar" } = Astro.props;
---

<div class="interactive-cursor" data-interactive-cursor aria-hidden="true">
  <div class="cursor-pill" data-cursor-pill>
    <div class="cursor-content" data-cursor-content>
      <span class="cursor-text" data-cursor-text>
        {defaultLabel}
      </span>
      <svg class="cursor-icon" viewBox="0 0 8 10" fill="none" aria-hidden="true">
        <path
          d="M1.5 1.2L6 5L1.5 8.8"
          stroke="currentColor"
          stroke-width="1.35"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
    <svg class="cursor-mute-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M2.5 6.5H5.5L9 3.5V12.5L5.5 9.5H2.5V6.5Z"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M11.5 6.5L14.5 9.5M14.5 6.5L11.5 9.5"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</div>

<style>
  .interactive-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    z-index: var(--z-cursor);
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
    transition: opacity var(--dur-fast) var(--ease-fast);
  }

  .interactive-cursor.is-visible {
    opacity: 1;
  }

  .cursor-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-pill);
    corner-smoothing: 60%;
    -webkit-corner-smoothing: 0.6;
    background: linear-gradient(135deg, rgba(34, 31, 28, 0.12) 0%, rgba(14, 13, 12, 0.18) 100%);
    backdrop-filter: blur(20px) saturate(180%) brightness(105%);
    -webkit-backdrop-filter: blur(20px) saturate(180%) brightness(105%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-top-color: rgba(255, 255, 255, 0.45);
    box-shadow: inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.45);
    overflow: hidden;
    transform-origin: center center;
    will-change: width, height, transform;
    transition:
      width 0.36s cubic-bezier(0.34, 1.45, 0.64, 1),
      height 0.36s cubic-bezier(0.34, 1.45, 0.64, 1),
      padding 0.28s cubic-bezier(0.34, 1.25, 0.64, 1),
      transform 0.18s cubic-bezier(0.25, 1, 0.5, 1),
      background 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .interactive-cursor.is-inverted .cursor-pill {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.42) 0%,
      rgba(255, 255, 255, 0.18) 100%
    );
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.65);
    border-top-color: rgba(255, 255, 255, 0.95);
    border-bottom-color: rgba(255, 255, 255, 0.35);
    box-shadow:
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 16px 0 rgba(255, 255, 255, 0.22);
  }

  .interactive-cursor.is-expanded .cursor-pill {
    width: 124px;
    height: 42px;
    padding: 0 16px;
  }

  .interactive-cursor.is-muted .cursor-pill {
    width: 44px;
    height: 44px;
    padding: 0;
  }

  .cursor-content {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    opacity: 0;
    transform: scale(0.7);
    transform-origin: center center;
    will-change: opacity, transform;
    transition:
      opacity 0.09s ease-out,
      transform 0.12s ease-in;
  }

  .interactive-cursor.is-expanded .cursor-content {
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1) 0.06s,
      transform 0.34s cubic-bezier(0.34, 1.4, 0.64, 1) 0.06s;
  }

  .cursor-text {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    letter-spacing: var(--ls-labels);
    text-transform: uppercase;
    font-weight: var(--weight-semibold);
    line-height: 1;
    color: inherit;
  }

  .cursor-icon {
    width: 8px;
    height: 11px;
    flex-shrink: 0;
    color: inherit;
  }

  .cursor-mute-icon {
    position: absolute;
    width: 18px;
    height: 18px;
    color: inherit;
    opacity: 0;
    transform: scale(0.35) rotate(-12deg);
    transform-origin: center center;
    pointer-events: none;
    will-change: opacity, transform;
    transition:
      opacity 0.08s ease-out,
      transform 0.12s ease-in;
  }

  .interactive-cursor.is-muted .cursor-mute-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
    transition:
      opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1) 0.07s,
      transform 0.36s cubic-bezier(0.34, 1.55, 0.64, 1) 0.07s;
  }

  .interactive-cursor.is-pressed .cursor-pill {
    transform: scale(0.88);
  }

  @media (hover: none) or (pointer: coarse) {
    .interactive-cursor {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-pill,
    .cursor-content {
      transition: none !important;
    }
  }
</style>
