---
import "./interactive-cursor.css";

interface Props {
  defaultLabel?: string;
}

const { defaultLabel = "Ingresar" } = Astro.props;
---

<div
  class="interactive-cursor"
  data-interactive-cursor
  transition:persist="interactive-cursor"
  aria-hidden="true"
  data-nosnippet
>
  <div class="cursor-ring" data-cursor-ring>
    <div class="cursor-pill" data-cursor-pill>
      <div class="cursor-backdrop" data-cursor-backdrop></div>
      <div class="cursor-content" data-cursor-content>
        <span class="cursor-text" data-cursor-text>
          {defaultLabel}
        </span>
        <svg class="cursor-icon" viewBox="0 0 8 10" fill="none" aria-hidden="true">
          <path
            d="M1.5 1.2L6 5L1.5 8.8"
            stroke="currentColor"
            stroke-width="1.35"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <svg class="cursor-mute-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M2.5 6.5H5.5L9 3.5V12.5L5.5 9.5H2.5V6.5Z"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M11.5 6.5L14.5 9.5M14.5 6.5L11.5 9.5"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>
  </div>
</div>

<script>
  import { getCursorController } from "./cursor-controller";

  const initGlobalCursor = () => {
    getCursorController().enable();
  };

  document.addEventListener("astro:page-load", initGlobalCursor);
  if (document.readyState !== "loading") initGlobalCursor();
  else document.addEventListener("DOMContentLoaded", initGlobalCursor);
</script>
